{
  "name": "halli-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [{"binding": "HALLI_KV", "id": "24d27c99a4ee43cab68096d4eaa48f4b"}],
  "routes": [
    {"pattern": "hairbyhallij.com", "custom_domain": true},
    {"pattern": "www.hairbyhallij.com", "custom_domain": true}
  ]
}
